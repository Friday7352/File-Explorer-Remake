<Window x:Class="Clearspace.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Clearspace" Width="1400" Height="900" MinWidth="1060" MinHeight="680" Background="{StaticResource BgBrush}" Foreground="{StaticResource InkBrush}" FontFamily="Segoe UI Variable Text" KeyDown="Window_KeyDown">
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="252"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="{StaticResource SideBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0"><Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="52"/><RowDefinition Height="29"/><RowDefinition Height="Auto"/><RowDefinition Height="31"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="78"/></Grid.RowDefinitions>
      <StackPanel><TextBlock Text="✦  Clearspace" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="Your files, clearly organized" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="3,5,0,20"/></StackPanel><Button Grid.Row="1" Content="＋  New folder" Background="#2D2F33" HorizontalContentAlignment="Left" Click="NewFolder_Click"/><TextBlock Grid.Row="2" Text="WORKSPACE" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold" Margin="11,12,0,0"/>
      <ListBox x:Name="QuickNav" Grid.Row="3" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource NavButton}" SelectionChanged="Navigation_SelectionChanged"><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}"/></DataTemplate></ListBox.ItemTemplate></ListBox><TextBlock Grid.Row="4" Text="THIS PC &amp; NETWORK" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold" Margin="11,12,0,0"/>
      <ListBox x:Name="ComputerNav" Grid.Row="5" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource NavButton}" SelectionChanged="Navigation_SelectionChanged"><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"/></DataTemplate></ListBox.ItemTemplate></ListBox>
      <StackPanel Grid.Row="7"><Button Content="＋  Add network drive" HorizontalContentAlignment="Left" Foreground="{StaticResource AccentBrush}" Click="AddNetwork_Click"/><Border Background="#292A2E" CornerRadius="11" Padding="12" Margin="0,8,0,0"><StackPanel><DockPanel LastChildFill="False"><TextBlock Text="Local storage" FontWeight="SemiBold" FontSize="11"/><TextBlock x:Name="StorageLabel" Foreground="{StaticResource MutedBrush}" FontSize="10" DockPanel.Dock="Right" Margin="8,0,0,0"/></DockPanel><ProgressBar x:Name="StorageBar" Height="4" Margin="0,9,0,0" Maximum="100" Foreground="{StaticResource AccentBrush}" Background="#46484D" BorderThickness="0"/></StackPanel></Border></StackPanel>
    </Grid></Border>
    <Grid Grid.Column="1" Margin="42,25,42,30"><Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="91"/><RowDefinition Height="43"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="93"/><ColumnDefinition Width="*"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><Button Content="‹" FontSize="21" Padding="7,0" Click="Back_Click"/><Button Content="›" FontSize="21" Padding="7,0" Click="Forward_Click"/><Button Content="↑" FontSize="18" Padding="9,0" Click="Up_Click"/></StackPanel><Border Grid.Column="1" Background="#292630" CornerRadius="11" Margin="12,0"><TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0" Foreground="{StaticResource InkBrush}" VerticalContentAlignment="Center" Padding="14,0" FontSize="13" TextChanged="SearchBox_TextChanged" ToolTip="Search this folder"/></Border><Button Grid.Column="2" Content="◐" Background="#292630" FontSize="16" ToolTip="Appearance"/></Grid>
      <Grid Grid.Row="1" VerticalAlignment="Center"><StackPanel><TextBlock Text="LOCATION" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="LocationTitle" FontFamily="Segoe UI Variable Display" FontWeight="SemiBold" FontSize="29" Margin="0,4,0,0"/></StackPanel><TextBlock x:Name="StatusText" Text="●  Everything is ready" Foreground="#8DD1B1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,5"/></Grid>
      <Border Grid.Row="2" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,1"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Button Content="⇅  Sort" Click="Sort_Click"/><Rectangle Width="1" Height="18" Fill="{StaticResource LineBrush}" Margin="7,0"/><Button Content="Copy" Click="Copy_Click"/><Button Content="Cut" Click="Cut_Click"/><Button Content="Paste" Click="Paste_Click"/><Button Content="Rename" Click="Rename_Click"/><Button Content="Delete" Click="Delete_Click"/></StackPanel></Border>
      <Border x:Name="HomeSummary" Grid.Row="3" Background="#292A2E" BorderBrush="#3A3C41" BorderThickness="1" CornerRadius="14" Margin="0,22,0,28" Padding="17"><DockPanel><TextBlock Text="⌁" FontSize="21" Foreground="{StaticResource AccentBrush}" Margin="0,0,13,0"/><StackPanel><TextBlock Text="Pick up where you left off" FontWeight="SemiBold" FontSize="13"/><TextBlock Text="Browse your Windows folders, network locations, and recent work in one calm place." Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,3,0,0"/></StackPanel></DockPanel></Border>
      <StackPanel x:Name="QuickAccessSection" Grid.Row="4"><DockPanel><StackPanel><TextBlock Text="Quick access" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="Places you use the most" Foreground="{StaticResource MutedBrush}" FontSize="12"/></StackPanel></DockPanel><ItemsControl x:Name="QuickCards" Margin="0,14,0,30"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="5"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Tag="{Binding}" Click="QuickCard_Click" Padding="0" Margin="0,0,10,0"><Border Background="#292630" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="12" Padding="12"><StackPanel><TextBlock Text="▰" Foreground="{StaticResource AccentBrush}" FontSize="25"/><TextBlock Text="{Binding Label}" FontWeight="SemiBold" Margin="0,5,0,0"/><TextBlock Text="{Binding Detail}" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/></StackPanel></Border></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
      <Grid Grid.Row="5"><Grid.RowDefinitions><RowDefinition Height="47"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel><StackPanel><TextBlock x:Name="FilesHeading" Text="Files and folders" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="A clean list for the location you chose" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,2,0,0"/></StackPanel><TextBlock x:Name="ItemCount" Foreground="{StaticResource MutedBrush}" DockPanel.Dock="Right" VerticalAlignment="Center"/></DockPanel>
        <Border Grid.Row="1" Background="#27242D" BorderBrush="#3B3744" BorderThickness="1" CornerRadius="14" ClipToBounds="True"><Grid><Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Grid Background="#303135"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="155"/><ColumnDefinition Width="185"/><ColumnDefinition Width="185"/></Grid.ColumnDefinitions><TextBlock Text="Name" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" Margin="18,0" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="Type" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/><TextBlock Grid.Column="2" Text="Capacity" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/><TextBlock Grid.Column="3" Text="Date modified" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/></Grid>
          <ListBox x:Name="FileGrid" Grid.Row="1" Background="Transparent" BorderThickness="0" SelectionMode="Extended" MouseDoubleClick="FileGrid_DoubleClick" PreviewMouseRightButtonDown="FileGrid_RightClick" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"><ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate></ListBox.ItemsPanel><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="0"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="{StaticResource InkBrush}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="row" Background="Transparent" BorderBrush="#3A3C41" BorderThickness="0,0,0,1" Padding="0"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="row" Property="Background" Value="#3A3C41"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="row" Property="Background" Value="#323438"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle><ListBox.ItemTemplate><DataTemplate><Grid Height="58"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="155"/><ColumnDefinition Width="185"/><ColumnDefinition Width="185"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center" Margin="16,0"><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Preview}" Foreground="{Binding PreviewBrush}" FontWeight="SemiBold" Width="30"/><TextBlock Text="{Binding Name}" Foreground="{StaticResource InkBrush}" TextTrimming="CharacterEllipsis"/></StackPanel><ProgressBar Value="{Binding UsagePercent}" Maximum="100" Height="4" Width="240" Margin="30,6,0,0" Foreground="#AEB4BB" Background="#46484D" BorderThickness="0" Visibility="{Binding DriveVisibility}"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding TypeLabel}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/><TextBlock Grid.Column="2" Text="{Binding SizeLabel}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/><TextBlock Grid.Column="3" Text="{Binding ModifiedLabel}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/></Grid></DataTemplate></ListBox.ItemTemplate><ListBox.ContextMenu><ContextMenu><MenuItem Header="Open" Click="Open_Click"/><MenuItem Header="Open in Windows File Explorer" Click="OpenInExplorer_Click"/><Separator/><MenuItem Header="Copy" Click="Copy_Click"/><MenuItem Header="Cut" Click="Cut_Click"/><MenuItem Header="Paste" Click="Paste_Click"/><Separator/><MenuItem Header="Rename" Click="Rename_Click"/><MenuItem Header="Delete" Click="Delete_Click"/><Separator/><MenuItem Header="New folder" Click="NewFolder_Click"/></ContextMenu></ListBox.ContextMenu></ListBox>
          <Border x:Name="LoadingOverlay" Grid.RowSpan="2" Background="#D9202020" Visibility="Collapsed"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><ProgressBar IsIndeterminate="True" Width="150" Height="4" Foreground="{StaticResource AccentBrush}" Background="#3A363F" BorderThickness="0"/><TextBlock Text="Loading this location…" Foreground="{StaticResource MutedBrush}" Margin="0,13,0,0" HorizontalAlignment="Center"/></StackPanel></Border>
        </Grid></Border>
      </Grid>
    </Grid>
  </Grid>
</Window>
