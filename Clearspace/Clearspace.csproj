<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <AssemblyName>Clearspace</AssemblyName>
    <RootNamespace>Clearspace</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Clearspace.ico</ApplicationIcon>

    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>

    <!-- Publish as one double-clickable exe. Framework-dependent means our own
         assembly is the only thing bundled, so nothing is extracted to disk at
         launch; the WPF native libraries come from the shared runtime. -->
    <PublishSingleFile>true</PublishSingleFile>
    <PublishReadyToRun>true</PublishReadyToRun>
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <!-- WPF depends on native presentation libraries. Keep them inside the
         single-file release so an installer only has one app file to deploy. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>

    <!-- Startup time is a headline goal, so keep the runtime lean and warm. -->
    <TieredPGO>true</TieredPGO>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- The Windows Search index is reached through its OLE DB provider,
         Search.CollatorDSO. System.Data.OleDb is not in the shared framework,
         so it comes in as a package. -->
    <PackageReference Include="System.Data.OleDb" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The executable resource supplies the taskbar icon; this packaged copy is
         what WPF uses for the window chrome and Alt+Tab icon. -->
    <Resource Include="Assets\Clearspace.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- Screenshot-safe images used only by Clearspace demo mode. They stay beside
         the app so the in-app photo viewer can decode full-resolution originals. -->
    <Content Include="Assets\Demo\*.png"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
