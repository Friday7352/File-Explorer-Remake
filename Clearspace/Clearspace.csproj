<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <AssemblyName>Clearspace</AssemblyName>
    <RootNamespace>Clearspace</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Clearspace.ico</ApplicationIcon>

    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>

    <!-- Publish as one double-clickable exe. Framework-dependent means our own
         assembly is the only thing bundled, so nothing is extracted to disk at
         launch; the WPF native libraries come from the shared runtime. -->
    <PublishSingleFile>true</PublishSingleFile>
    <PublishReadyToRun>true</PublishReadyToRun>
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>

    <!-- Startup time is a headline goal, so keep the runtime lean and warm. -->
    <TieredPGO>true</TieredPGO>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- The executable resource supplies the taskbar icon; this packaged copy is
         what WPF uses for the window chrome and Alt+Tab icon. -->
    <Resource Include="Assets\Clearspace.ico" />
  </ItemGroup>

</Project>
