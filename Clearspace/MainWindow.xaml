<Window x:Class="Clearspace.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Clearspace.ViewModels"
        Title="Clearspace"
        Height="780" Width="1240"
        MinHeight="480" MinWidth="820"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Surface}"
        Foreground="{StaticResource Text}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="12.5"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0"
                Background="{StaticResource SurfaceRaised}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="8,7">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button Style="{StaticResource ToolButton}" Content="&#xE72B;"
                            Command="{Binding BackCommand}" ToolTip="Back (Alt+Left)" />
                    <Button Style="{StaticResource ToolButton}" Content="&#xE72A;"
                            Command="{Binding ForwardCommand}" ToolTip="Forward (Alt+Right)" />
                    <Button Style="{StaticResource ToolButton}" Content="&#xE74A;"
                            Command="{Binding UpCommand}" ToolTip="Up (Alt+Up)" />
                    <Button Style="{StaticResource ToolButton}" Content="&#xE72C;"
                            Command="{Binding RefreshCommand}" ToolTip="Refresh (F5)" />
                </StackPanel>

                <Border Grid.Column="1"
                        Background="{StaticResource SurfaceSunken}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="5"
                        Margin="10,0"
                        Height="30">
                    <Grid>
                        <!-- Breadcrumb view, swapped for the editable box on focus. -->
                        <ItemsControl x:Name="BreadcrumbBar"
                                      ItemsSource="{Binding Breadcrumbs}"
                                      VerticalAlignment="Center"
                                      Margin="2,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource CrumbButton}"
                                                Content="{Binding Name}"
                                                Tag="{Binding Path}"
                                                Click="OnBreadcrumbClick" />
                                        <TextBlock Text="&#xE76C;"
                                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                   FontSize="9"
                                                   VerticalAlignment="Center"
                                                   Foreground="{StaticResource TextMuted}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBox x:Name="AddressBox"
                                 Text="{Binding AddressText, UpdateSourceTrigger=PropertyChanged}"
                                 Background="Transparent"
                                 Foreground="{StaticResource Text}"
                                 CaretBrush="{StaticResource Text}"
                                 BorderThickness="0"
                                 Padding="8,0"
                                 VerticalContentAlignment="Center"
                                 Visibility="Collapsed"
                                 KeyDown="OnAddressKeyDown"
                                 LostFocus="OnAddressLostFocus" />

                        <!-- Transparent strip that turns the breadcrumb into an edit box. -->
                        <Border Background="Transparent"
                                x:Name="AddressActivator"
                                MouseLeftButtonDown="OnAddressActivate" />
                    </Grid>
                </Border>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Style="{StaticResource ToolButton}" Content="&#xE8F4;"
                            Command="{Binding NewFolderCommand}" ToolTip="New folder (Ctrl+Shift+N)" />
                    <Button Style="{StaticResource ToolButton}" Content="&#xE756;"
                            Command="{Binding TerminalCommand}" ToolTip="Open in Terminal (Ctrl+`)" />
                    <ToggleButton x:Name="HiddenToggle"
                                  Content="&#xE7B3;"
                                  IsChecked="{Binding ShowHiddenItems}"
                                  ToolTip="Show hidden items"
                                  Width="34" Height="30"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  Foreground="{StaticResource Text}"
                                  FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                  FontSize="13"
                                  Cursor="Hand" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Body -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" MinWidth="150" MaxWidth="420" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Grid.Column="0" Background="{StaticResource SurfaceRaised}">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="0,8">
                    <ItemsControl ItemsSource="{Binding Sidebar}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <TextBlock Text="{Binding Name}"
                                               Margin="20,12,0,4"
                                               FontSize="10.5"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextMuted}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsHeader}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <Button Content="{Binding Name}"
                                            Tag="{Binding Path}"
                                            Click="OnSidebarClick">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource SidebarButton}">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsHeader}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <GridSplitter Grid.Column="1"
                          Width="1"
                          HorizontalAlignment="Stretch"
                          Background="{StaticResource BorderBrush}" />

            <!-- File list -->
            <Grid Grid.Column="2">
                <ListView x:Name="FileList"
                          ItemsSource="{Binding Items}"
                          ItemContainerStyle="{StaticResource FileRow}"
                          Background="Transparent"
                          BorderThickness="0"
                          Foreground="{StaticResource Text}"
                          SelectionMode="Extended"
                          SelectionChanged="OnSelectionChanged"
                          MouseDoubleClick="OnItemDoubleClick"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          VirtualizingPanel.ScrollUnit="Pixel"
                          ScrollViewer.IsDeferredScrollingEnabled="False">

                    <ListView.ContextMenu>
                        <ContextMenu Style="{StaticResource DarkMenu}">
                            <MenuItem Header="Open" Command="{Binding OpenCommand}" />
                            <Separator />
                            <MenuItem Header="Cut" Command="{Binding CutCommand}" InputGestureText="Ctrl+X" />
                            <MenuItem Header="Copy" Command="{Binding CopyCommand}" InputGestureText="Ctrl+C" />
                            <MenuItem Header="Paste" Command="{Binding PasteCommand}" InputGestureText="Ctrl+V" />
                            <MenuItem Header="Copy path" Command="{Binding CopyPathCommand}" InputGestureText="Ctrl+Shift+C" />
                            <Separator />
                            <MenuItem Header="Rename" Command="{Binding RenameCommand}" InputGestureText="F2" />
                            <MenuItem Header="Delete" Command="{Binding DeleteCommand}" InputGestureText="Del" />
                            <Separator />
                            <MenuItem Header="New folder" Command="{Binding NewFolderCommand}" InputGestureText="Ctrl+Shift+N" />
                            <MenuItem Header="Open in Terminal" Command="{Binding TerminalCommand}" />
                            <Separator />
                            <MenuItem Header="Properties" Command="{Binding PropertiesCommand}" InputGestureText="Alt+Enter" />
                        </ContextMenu>
                    </ListView.ContextMenu>

                    <ListView.View>
                        <GridView ColumnHeaderContainerStyle="{StaticResource ColumnHeader}">
                            <GridViewColumn Width="380" Header="Name">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="{Binding Icon}"
                                                   Width="16" Height="16"
                                                   Margin="4,0,8,0"
                                                   RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                            <TextBlock Text="{Binding Name}"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <GridViewColumn Width="170" Header="Date modified">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DateModifiedText}"
                                                   Foreground="{StaticResource TextMuted}"
                                                   Margin="8,0,0,0"
                                                   VerticalAlignment="Center" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <GridViewColumn Width="160" Header="Type">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding TypeName}"
                                                   Foreground="{StaticResource TextMuted}"
                                                   Margin="8,0,0,0"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <GridViewColumn Width="110" Header="Size">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding SizeText}"
                                                   Foreground="{StaticResource TextMuted}"
                                                   Margin="8,0,0,0"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>

                <!-- Inline rename overlay -->
                <Border x:Name="RenamePanel"
                        Visibility="Collapsed"
                        Background="{StaticResource SurfaceRaised}"
                        BorderBrush="{StaticResource Accent}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="16"
                        Width="420"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="Rename" FontWeight="SemiBold" Margin="0,0,0,10" />
                        <TextBox x:Name="RenameBox"
                                 Background="{StaticResource SurfaceSunken}"
                                 Foreground="{StaticResource Text}"
                                 CaretBrush="{StaticResource Text}"
                                 BorderBrush="{StaticResource BorderBrush}"
                                 BorderThickness="1"
                                 Padding="8,6"
                                 KeyDown="OnRenameKeyDown" />
                        <TextBlock Text="Enter to confirm, Esc to cancel"
                                   Foreground="{StaticResource TextMuted}"
                                   FontSize="11"
                                   Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="2"
                Background="{StaticResource SurfaceRaised}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="14,5">
            <TextBlock Text="{Binding StatusText}"
                       Foreground="{StaticResource TextMuted}"
                       FontSize="11.5" />
        </Border>
    </Grid>
</Window>
